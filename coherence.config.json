{
  "name": "portfolio",
  "language": "typescript",
  "ignore": [
    "node_modules",
    ".next",
    ".next-verify",
    ".vercel",
    ".coherence/archive-0.37",
    "public",
    "content",
    "data",
    "scripts"
  ],
  "wellKnown": ["Jake", "Spotify", "Strava", "Trakt", "WakaTime", "Obsidian", "Redis", "Upstash", "Vercel", "PostHog", "GitHub", "Next", "SQLite", "GSAP", "Lenis", "Geist", "vinelab"],
  "test": "node --test --test-reporter=tap --test-name-pattern {filter} \"app/lib/**/*.test.mjs\" \"scripts/**/*.test.mjs\" \"services/**/*.test.mjs\"",
  "testMatch": "(?:^|\\n)ok \\d+ - (?!\\S+\\.test\\.mjs\\r?\\n)(?![^\\n]*# SKIP)"
}
